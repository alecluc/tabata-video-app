# ── Base de datos (Vercel Postgres / Neon) ──
DATABASE_URL=

# ── Auth (NextAuth) ──
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ── AdSense (web / PWA en Vercel) ──
# Publisher ID desde https://adsense.google.com → Cuenta → Información de la cuenta
NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-XXXXXXXXXXXXXXXX
# Unidad display para intervalos de descanso (WorkoutPlayer)
NEXT_PUBLIC_ADSENSE_SLOT_REST=
# Unidad opcional en la home (fallback si el slot de descanso no sirve en SPA)
NEXT_PUBLIC_ADSENSE_SLOT_HOME=

# ── AdMob (Android Capacitor) ──
# App ID va en android/app/src/main/res/values/strings.xml → admob_app_id
# Banner durante descanso (env o panel /admin/ads). Vacío = ID de prueba en dev.
NEXT_PUBLIC_ADMOB_REST_BANNER_ID=

# google-services.json: no commitear. Copialo a android/app/ si usás Firebase/AdMob vinculado.
